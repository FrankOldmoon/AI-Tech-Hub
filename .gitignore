# Nuxt dev/build outputs
.output
.vercel
.data
.nuxt
.nitro
.cache
dist

# Node dependencies
node_modules

# Logs
logs
*.log
.dev-server.log*

# Misc
.DS_Store
.fleet
.idea

# Local env files
.env
.env.*
!.env.example

# Python (generic; local Python backend removed)
*.pyc
.venv/
__pycache__/

# AI 模型文件不入库（.models/，由 model-downloader 预下载，model API 路由 Range 服务）
.models/*
# 需要分发到内网的 yolo 子目录：反转目录本身使 git 能进入遍历
!.models/yolo/

# onnxruntime WASM 自托管（node_modules/onnxruntime-web/dist 复制，部署时需同步）
# 注：为让 YOLO 页面部署后开箱可用，此处跟随需求把 vendored WASM 一并入库
# public/vendor/onnx/

# ??????????????????
public/generated/
tmp/

*.pth
*.pt
*.ckpt
*.safetensors
*.onnx
*.bin
*.msgpack
*.npy
*.npz
*.gz
# microduck 仿真器 RL 策略（pollen-robotics 官方 ONNX 导出，需随应用分发到内网，不能忽略）
!public/apps/microduck/policies/*.onnx
# g1-cartpole（mjswan G1 人形 + Cartpole 平衡）策略 ONNX，需随应用分发到内网
!public/apps/g1-cartpole/oursim/assets/**/*.onnx
# g1-motion-tracking（humanoid-policy-viewer）G1 追踪策略 ONNX
!public/apps/g1-motion-tracking/examples/checkpoints/g1/policy_latest.onnx
# YOLO26 全任务检测模型（.models/yolo/*.onnx）需随应用分发到内网
!.models/yolo/yolo26*.onnx

# Playwright CLI ????????
.playwright-cli/
tmp/chrome-headless/

# runtime temp (port/debug leftovers)
3001/

# 杂散产物（勿提交）
output/

# 工具会话目录（勿提交）
.dumate/
.workbuddy/

# 独立应用模型/大数据（不入库，部署时上传）
# 学生人脸识别小工具：含学生名单（姓名/班级）与人脸特征记录等个人信息，
# 本仓库为公开仓库，因此不收录（另注：其 models/*.bin 已被上面的 *.bin 规则忽略，
# 即使提交也无法从新克隆直接运行）
public/face/
