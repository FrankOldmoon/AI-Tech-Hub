# Nuxt dev/build outputs
.output
.vercel
.data
.nuxt
.nitro
.cache
dist

# Node dependencies
node_modules

# Logs
logs
*.log
.dev-server.log*

# Misc
.DS_Store
.fleet
.idea

# Local env files
.env
.env.*
!.env.example

# Python (generic; local Python backend removed)
*.pyc
.venv/
__pycache__/

# AI 模型文件一律不入库（.models/）：
#   本地开发 → model-downloader 预下载 / scripts/fetch-models.mjs
#   部署机   → 同样跑下载脚本，或直接把已下好的 .models/ scp 上去
# 理由：单个 onnx 动辄 60MB+，进仓库会让 clone 变慢且几乎不可回退。
.models/*

# onnxruntime WASM 自托管（node_modules/onnxruntime-web/dist 复制，部署时需同步）
# 注：为让 YOLO 页面部署后开箱可用，此处跟随需求把 vendored WASM 一并入库
# public/vendor/onnx/

# ??????????????????
public/generated/
tmp/

*.pth
*.pt
*.ckpt
*.safetensors
*.onnx
*.bin
*.msgpack
*.npy
*.npz
*.gz
# microduck 仿真器 RL 策略（pollen-robotics 官方 ONNX 导出，需随应用分发到内网，不能忽略）
!public/apps/microduck/policies/*.onnx
# g1-cartpole（mjswan G1 人形 + Cartpole 平衡）策略 ONNX，需随应用分发到内网
!public/apps/g1-cartpole/oursim/assets/**/*.onnx
# g1-motion-tracking（humanoid-policy-viewer）G1 追踪策略 ONNX
!public/apps/g1-motion-tracking/examples/checkpoints/g1/policy_latest.onnx

# Playwright CLI ????????
.playwright-cli/
tmp/chrome-headless/

# Playwright E2E 产物（trace / 截图 / HTML 报告）
test-results/
tests/e2e/.report/

# Program World 测试台的临时 Chrome profile（scripts/test-program-world.mjs）
.program-world-test-profile/

# runtime temp (port/debug leftovers)
3001/

# 杂散产物（勿提交）
output/

# 工具会话目录（勿提交）
.dumate/
.workbuddy/
.workbuddy-ai/

# 独立应用模型/大数据（不入库，部署时上传）
# 学生人脸识别小工具（public/face/）：**代码入库，个人信息不入库** ——
#   students-*.json         学生姓名/班级与人脸特征记录（个人信息，公开仓库不收录）
#   calibration-report.json 由上述数据生成的标定报告
#   models/                 模型权重（遵守全站「模型文件不入库」约定；*.bin 另被上面的规则忽略）
public/face/students-*.json
public/face/calibration-report.json
public/face/models/
