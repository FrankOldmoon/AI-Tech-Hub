# Cloud LLM chat (llm-chat demo) API keys - copy to .env and fill in real keys (.env is gitignored)
MOONSHOT_API_KEY=
DEEPSEEK_API_KEY=
# 外部 OpenAI 兼容 API（/v1/*）的调用方 key 白名单，逗号分隔；留空 = 对外关闭
OPENAI_COMPAT_API_KEYS=
# 自定义上游供应商（任意 OpenAI 兼容服务），按 ID 前缀声明，可配多个；
# BASE_URL 与 MODELS 齐全才生效；API_KEY 缺省 = 无密钥上游（如本地 Ollama）
#LLM_PROVIDER_FOO_BASE_URL=https://api.foo.com/v1
#LLM_PROVIDER_FOO_API_KEY=sk-xxx
#LLM_PROVIDER_FOO_MODELS=foo-large,foo-mini
#LLM_PROVIDER_FOO_LABEL=Foo AI
#LLM_PROVIDER_FOO_THINKING_MODELS=foo-large
