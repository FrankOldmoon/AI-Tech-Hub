{
  "name": "nn",
  "version": "0.11.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nuxt build && node scripts/trim-production-assets.mjs",
    "dev": "NODE_USE_ENV_PROXY=1 nuxt dev --host",
    "preview": "nuxt preview",
    "server": "node .output/server/index.mjs",
    "check:i18n": "node scripts/check-i18n.mjs",
    "models:fetch": "node scripts/fetch-models.mjs",
    "models:list": "node scripts/fetch-models.mjs --list",
    "postinstall": "nuxt prepare",
    "lint": "eslint .",
    "typecheck": "nuxt typecheck",
    "test": "vitest run"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0",
    "@iconify-json/lucide": "^1.2.121",
    "@iconify-json/simple-icons": "^1.2.92",
    "@mediapipe/tasks-audio": "^1.0.1",
    "@mediapipe/tasks-text": "^1.0.1",
    "@mediapipe/tasks-vision": "^1.0.1",
    "@mlc-ai/web-llm": "^0.2.84",
    "@nuxt/ui": "^4.10.0",
    "@nuxtjs/i18n": "10.6.0",
    "@tensorflow-models/knn-classifier": "^1.2.6",
    "@tensorflow-models/mobilenet": "^2.1.1",
    "@tensorflow-models/speech-commands": "^0.5.4",
    "@tensorflow/tfjs": "^4.22.0",
    "@vladmandic/face-api": "^1.7.15",
    "kokoro-js": "^1.2.1",
    "nuxt": "^4.5.2",
    "onnxruntime-web": "^1.27.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.16.0",
    "eslint": "^10.8.0",
    "long": "4.0.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10",
    "vue": "^3.5.41",
    "vue-tsc": "^3.3.9"
  },
  "packageManager": "pnpm@11.18.0"
}
