{
  "name": "nn",
  "version": "0.11.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/check-program-world-worker.mjs && nuxt build && node scripts/check-program-world-worker.mjs --artifacts && node scripts/trim-production-assets.mjs",
    "dev": "NODE_USE_ENV_PROXY=1 nuxt dev --host",
    "preview": "nuxt preview",
    "server": "node .output/server/index.mjs",
    "check:i18n": "node scripts/check-i18n.mjs",
    "check:program-world": "node scripts/check-program-world-worker.mjs",
    "models:fetch": "node scripts/fetch-models.mjs",
    "models:list": "node scripts/fetch-models.mjs --list",
    "postinstall": "nuxt prepare && node scripts/sync-runtime-libs.mjs",
    "lint": "eslint .",
    "typecheck": "nuxt typecheck",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:routes": "playwright test tests/e2e/routes.spec.ts",
    "test:e2e:ops": "playwright test tests/e2e/operations.spec.ts",
    "test:e2e:tools": "playwright test tests/e2e/tools.spec.ts",
    "test:e2e:report": "playwright show-report tests/e2e/.report",
    "test:program-world": "node scripts/test-program-world.mjs"
  },
  "dependencies": {
    "@ffmpeg/core": "0.12.6",
    "@ffmpeg/ffmpeg": "0.12.10",
    "@huggingface/transformers": "^4.2.0",
    "@iconify-json/lucide": "^1.2.121",
    "@iconify-json/simple-icons": "^1.2.92",
    "@mediapipe/tasks-audio": "^1.0.1",
    "@mediapipe/tasks-text": "^1.0.1",
    "@mediapipe/tasks-vision": "^1.0.1",
    "@mlc-ai/web-llm": "^0.2.84",
    "@nuxt/ui": "^4.10.0",
    "@nuxtjs/i18n": "10.6.0",
    "@tensorflow-models/knn-classifier": "^1.2.6",
    "@tensorflow-models/mobilenet": "^2.1.1",
    "@tensorflow-models/speech-commands": "^0.5.4",
    "@tensorflow/tfjs": "^4.22.0",
    "@vladmandic/face-api": "^1.7.15",
    "kokoro-js": "^1.2.1",
    "ml5": "1.4.0",
    "monaco-editor": "0.52.2",
    "nuxt": "^4.5.2",
    "onnxruntime-web": "^1.27.0",
    "pyodide": "0.27.7",
    "tailwindcss": "^4.3.3",
    "tesseract.js": "5.1.1",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.16.0",
    "@playwright/test": "^1.63.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^10.8.0",
    "happy-dom": "^15.11.7",
    "long": "4.0.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10",
    "vue": "^3.5.41",
    "vue-tsc": "^3.3.9"
  },
  "pnpm": {
    "neverBuiltDependencies": [
      "ml5"
    ]
  },
  "packageManager": "pnpm@11.18.0"
}
